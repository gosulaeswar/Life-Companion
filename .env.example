# Third-party xAI Grok API key (set securely in the AI Studio Secrets panel or local .env — never commit real keys).
XAI_API_KEY=XAI_API_KEY_DEFAULT_VALUE

# Optional public HTTPS endpoints for Google Play purchase validation and remote pricing catalog:
