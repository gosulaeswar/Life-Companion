# Firebase AI Logic uses Firebase App Check attestation (no API key required in .env).
# Optional public HTTPS endpoints for Google Play purchase validation and remote pricing catalog:
# BILLING_VERIFICATION_URL=https://your-backend.example.com/v1/billing/verify
# BILLING_PRICING_CONFIG_URL=https://your-backend.example.com/v1/billing/pricing
# NEVER place Google Play Service Account JSON keys or private signing secrets in .env or the APK.
